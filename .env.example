# Public template. npm run setup replaces the two secret placeholders locally.
POSTGRES_PASSWORD=replace-with-a-new-random-value
DATABASE_URL=postgresql://agentos:replace-with-a-new-random-value@127.0.0.1:15482/agentos
AGENTOS_API_TOKEN=replace-with-a-new-random-value
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=4280
AGENTOS_ORIGIN=http://127.0.0.1:4280
AGENTOS_DATA_DIR=.local
AGENTOS_ROLE=all
AGENTOS_WORKER_SLOTS=16
AGENTOS_SCOPED_PLANNER_LIMIT=5
AGENTOS_REMOTE_EXECUTION=0
AGENTOS_BRIDGE_HOST=
AGENTOS_TAILNET_HOST=
AGENTOS_DSH_COMMAND=
AGENTOS_DSH_ARGS=[]
AGENTOS_LAYA_URL=
AGENTOS_RECALL_URL=
AGENTOS_RECALL_KEY=
AGENTOS_RECALL_NAMESPACE=agentos-development
